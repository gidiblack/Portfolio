<div class="admin-page">
  <div class="admin-container">
    <div class="admin-card">
      <h2>Edit Hero Section</h2>
      <% if (error) { %>
        <p class="admin-alert error"><%= error %></p>
      <% } %>
      <form class="admin-form" method="POST" action="/admin/hero">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>Headline: <input type="text" name="headline" value="<%= hero ? hero.headline : '' %>" required /></label>
        <label>Subheadline: <input type="text" name="subheadline" value="<%= hero ? hero.subheadline : '' %>" required /></label>
        <label>CTA Text: <input type="text" name="ctaText" value="<%= hero ? hero.ctaText : '' %>" required /></label>
        <label>CTA URL: <input type="text" name="ctaUrl" value="<%= hero ? hero.ctaUrl : '' %>" required /></label>
        <div class="admin-actions"><button class="btn-primary" type="submit">Save</button></div>
      </form>
    </div>
  </div>
</div>
