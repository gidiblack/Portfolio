<div class="admin-page">
  <div class="admin-container">
    <div class="admin-card">
      <h2>Edit About Section</h2>
      <% if (error) { %>
        <p class="admin-alert error"><%= error %></p>
      <% } %>
      <form class="admin-form" method="POST" action="/admin/about">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>Bio:<br /><textarea name="bio" required><%= about ? about.bio : '' %></textarea></label>
        <label>Highlights (comma separated):<br /><input type="text" name="highlights" value="<%= about && about.highlights ? about.highlights.join(', ') : '' %>" /></label>
        <div class="admin-actions"><button class="btn-primary" type="submit">Save</button></div>
      </form>
    </div>
  </div>
</div>
