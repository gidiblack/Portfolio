<div class="admin-page">
  <div class="admin-container">
    <div class="admin-card">
      <h2>Manage Resume</h2>

      <% if (error) { %>
        <p class="admin-alert error"><%= error %></p>
      <% } %>

      <% if (resumeAsset && resumeAsset.currentUrl) { %>
        <p>Current Resume: <a href="<%= resumeAsset.currentUrl %>" target="_blank" rel="noopener noreferrer"><%= resumeAsset.fileName || 'View Resume' %></a></p>
      <% } else { %>
        <p>No resume uploaded yet.</p>
      <% } %>

      <form class="admin-form" method="POST" action="/admin/resume?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
        <label>Upload PDF (max <%= maxSizeMb %> MB): <input type="file" name="resumeFile" accept="application/pdf,.pdf" required /></label>
        <div class="admin-actions"><button class="btn-primary" type="submit">Upload Resume</button></div>
      </form>
    </div>
  </div>
</div>
