<div class="admin-page">
  <div class="admin-container">
    <div class="admin-card">
      <h2>Manage Services</h2>
      <div class="admin-actions"><a class="btn-primary" href="/admin/services/new">Add Service</a></div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <tr><th>Title</th><th>Description</th><th>Order</th><th>Published</th><th>Actions</th></tr>
          <% services.forEach(function(service) { %>
            <tr>
              <td><%= service.title %></td>
              <td><%= service.description %></td>
              <td><%= service.order %></td>
              <td><%= service.published ? 'Yes' : 'No' %></td>
              <td>
                <a href="/admin/services/<%= service._id %>/edit">Edit</a>
                <span> | </span>
                <form class="inline-form" method="POST" action="/admin/services/<%= service._id %>/delete">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn-secondary" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </table>
      </div>
    </div>
  </div>
</div>
