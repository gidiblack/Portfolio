<div class="admin-page">
  <div class="admin-container">
    <div class="admin-card">
      <h2>Manage Social Links</h2>
      <div class="admin-actions"><a class="btn-primary" href="/admin/social/new">Add Social Link</a></div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <tr><th>Platform</th><th>URL</th><th>Order</th><th>Published</th><th>Actions</th></tr>
          <% socialLinks.forEach(function(link) { %>
            <tr>
              <td><%= link.platform %></td>
              <td><%= link.url %></td>
              <td><%= link.order %></td>
              <td><%= link.published ? 'Yes' : 'No' %></td>
              <td>
                <a href="/admin/social/<%= link._id %>/edit">Edit</a>
                <span> | </span>
                <form class="inline-form" method="POST" action="/admin/social/<%= link._id %>/delete">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn-secondary" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </table>
      </div>
    </div>
  </div>
</div>
