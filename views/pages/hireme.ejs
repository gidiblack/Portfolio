<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <link href="https://fonts.googleapis.com/css?family=Raleway&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/css/style.css" />
    <script src="https://kit.fontawesome.com/93c48aecb0.js" crossorigin="anonymous"></script>
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/assets/favicon/site.webmanifest" />
    <title>Hire Gideon</title>
  </head>
  <body>
    <button onclick="topFunction()" id="myBtn" title="Go to top">
      <i class="fa fa-angle-double-up"></i>
    </button>
    <header class="hireme-header">
      <nav class="nav-bar">
        <div class="container">
          <ul class="main-nav">
            <li>
              <a class="logo" href="/"><img src="/assets/img/gidi-logo.png" /></a>
            </li>
            <div id="responsive-nav" class="responsive-nav">
              <li><a href="/">Home</a></li>
              <li>
                <a
                  href="<%= resumeAsset && resumeAsset.currentUrl ? resumeAsset.currentUrl : '/assets/Gideon_Etim_Resume.pdf' %>"
                  download="Gideon Etim Resume"
                  target="_blank"
                  class="cta"
                  ><button class="btn-accent">Download Resume</button></a
                >
              </li>
            </div>
            <li class="menu-toggle">
              <div class="hamburger"></div>
            </li>
          </ul>
        </div>
      </nav>
      <div class="container hireme">
        <h1 class="text-center">Hire Me</h1>
        <p class="text-center">
          <em>"I am currently <span class="heading">accepting</span> new freelance projects"</em>
        </p>
      </div>
    </header>
    <main>
      <div class="container questionnaire text-center">
        <h2 class="heading">Questionnaire</h2>
        <p>
          Requesting an estimate for a project only takes a few minutes of your time and costs absolutely nothing. This
          questionnaire was built to help me identify your needs for the project.
        </p>
      </div>
      <section class="container" id="form-section">
        <iframe
          src="https://docs.google.com/forms/d/e/1FAIpQLSeO1MnpglLPxWUUogPQ95AH1J2jJIbGR-C0yAepe9-52rQZ-g/viewform?embedded=true"
          width="650"
          height="2300"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          >Loading…</iframe
        >
      </section>
    </main>
    <footer>
      <div class="container text-center">
        <p>&copy Gideon Etim 2025</p>
        <% const iconMap = { Twitter: 'twitter', GitHub: 'github', LinkedIn: 'linkedin', WhatsApp: 'whatsapp', Facebook: 'facebook', Instagram: 'instagram' }; %>
        <% (socialLinks || []).forEach(function(link) { const iconName = iconMap[link.platform] || 'link'; %>
        <a href="<%= link.url %>" target="_blank" rel="noreferrer"><i class="fab fa-<%= iconName %> fa-2x"></i></a>
        <% }) %>
      </div>
    </footer>
  </body>
  <script src="/assets/js/vendors/jquery.min.js"></script>
  <script src="/assets/js/vendors/bootstrap.bundle.min.js"></script>
  <script src="/assets/js/vendors/jquery.validate.min.js"></script>
  <script src="/assets/js/app.js"></script>
</html>
